{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entity://nota/v1",
  "title": "Nota",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "body"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "body": {
      "type": "string",
      "maxLength": 20000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      },
      "maxItems": 30
    }
  }
}
