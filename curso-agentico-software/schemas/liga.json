{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entity://liga/v1",
  "title": "Liga",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "url"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      },
      "maxItems": 30
    },
    "siteName": {
      "type": "string",
      "maxLength": 200
    },
    "imageUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "maxLength": 2048
    }
  }
}
