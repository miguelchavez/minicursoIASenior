{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entity://tarea/v1",
  "title": "Tarea",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "status"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "doing",
        "done"
      ]
    },
    "dueDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      },
      "maxItems": 30
    }
  }
}
